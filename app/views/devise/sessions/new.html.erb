<%# Entrar (/users/sign_in). Mesmo visual da Criar conta: cartão e campos .su-* e o login
    .li-* em auth.scss; olho da senha no signup_form_controller.js. Cabeçalho e rodapé
    próprios (shared/_auth_header e _auth_footer, via :auth_chrome no layout). %>
<% provide :auth_chrome, "1" %>
<meta name="turbo-cache-control" content="no-cache">
<script>
  window.addEventListener("pageshow", function(event) {
    if (event.persisted) { window.location.reload(); }
  });
</script>

<div class="su-page li-page">
  <p class="li-live"><i aria-hidden="true"></i>Ao vivo agora · gente perto de você</p>
  <h1 class="su-title li-title">Bem-vindo ao GeoMatch</h1>
  <p class="su-subtitle li-subtitle">Entre e veja quem está por perto agora.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name),
               html: { class: "su-card li-card", data: { controller: "signup-form" } }) do |f| %>
    <div class="su-field">
      <%= f.label :email, "E-mail", class: "su-label" %>
      <div class="su-input">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", required: true %>
      </div>
    </div>

    <div class="su-field">
      <%= f.label :password, "Senha", class: "su-label" %>
      <div class="su-input">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", required: true %>
        <%= render "devise/registrations/eye_button" %>
      </div>
    </div>

    <div class="li-row">
      <% if devise_mapping.rememberable? %>
        <label class="su-check li-remember">
          <%= f.check_box :remember_me %>
          <span class="su-box" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
          <span>Lembrar de mim</span>
        </label>
      <% end %>
      <% if devise_mapping.recoverable? %>
        <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "li-forgot" %>
      <% end %>
    </div>

    <%= f.submit "Entrar", class: "su-submit" %>

    <p class="su-privacy">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/></svg>
      Sua localização exata nunca é mostrada
    </p>
  <% end %>

  <p class="su-login">Novo por aqui? <%= link_to "Criar conta", new_registration_path(resource_name) %></p>
</div>
