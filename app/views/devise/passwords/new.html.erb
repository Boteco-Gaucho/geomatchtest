<%# Esqueceu a senha? (/users/password/new). Mesmo visual de Entrar / Criar conta: cartão e
    campo .su-*, topo .fp-* em auth.scss; cabeçalho ("Entrar") e rodapé próprios via :auth_chrome.
    "Enviar link" manda o e-mail de redefinição do Devise (passwords#create). %>
<% provide :auth_chrome, "1" %>

<div class="su-page fp-page">
  <%= link_to new_session_path(resource_name), class: "fp-back", aria: { label: "Voltar para Entrar" } do %>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
  <% end %>

  <span class="fp-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="M10.8 12.2L19 4M15.5 7.5l2.5 2.5M17.5 5.5l2 2"/></svg>
  </span>

  <h1 class="su-title fp-title">Esqueceu a senha?</h1>
  <p class="su-subtitle fp-subtitle">Acontece. Digite o e-mail da sua conta e enviamos um link para você criar uma nova senha.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "su-card fp-card" }) do |f| %>
    <% if resource.errors.any? %>
      <div class="su-errors" role="alert" data-turbo-cache="false">
        <% resource.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="su-field">
      <%= f.label :email, "E-mail", class: "su-label" %>
      <div class="su-input">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", required: true %>
      </div>
    </div>

    <%= f.submit "Enviar link", class: "su-submit" %>

    <p class="fp-note">Não chegou em alguns minutos? Confira a caixa de spam.</p>
  <% end %>

  <p class="su-login">Lembrou a senha? <%= link_to "Entrar", new_session_path(resource_name) %></p>
</div>
