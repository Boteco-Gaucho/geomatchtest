<% flash.each do |type, message| %>
  <%# Avisos próprios no topo: shared/_unfreeze_toast e shared/_profile_saved_toast %>
  <% next if %w[account_unfrozen profile_saved].include?(type.to_s) %>
  <%# "Você já está autenticado." chega do Devise como alerta (ao reabrir o app já logado),
      mas não é erro: aparece em verde %>
  <% tone = if message == t("devise.failure.already_authenticated") then "success"
            elsif type.to_s == "alert" then "alert"
            else "notice" end %>
  <div class="toast toast--<%= tone %>"
       data-controller="toast"
       role="alert"
       aria-live="polite">
    <span class="toast__message"><%= message %></span>
    <button class="toast__close" data-action="toast#close" aria-label="Fechar">✕</button>
  </div>
<% end %>
