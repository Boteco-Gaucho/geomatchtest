<%# Cabeçalho das telas de conta: logo + "Entrar" (na Criar conta) ou "Criar conta" (no
    Entrar). Estilos .au-* em auth.scss. Entra no lugar do .site-header quando a view faz
    provide :auth_chrome. %>
<header class="au-header">
  <%= link_to root_path, class: "au-brand", aria: { label: "GeoMatch — início" } do %>
    <%= image_tag "logo-geomatch-dourada.png", alt: "GeoMatch", class: "au-brand-logo" %>
  <% end %>
  <% if controller_name == "sessions" %>
    <%= link_to "Criar conta", new_user_registration_path, class: "au-login" %>
  <% else %>
    <%= link_to "Entrar", new_user_session_path, class: "au-login" %>
  <% end %>
</header>
