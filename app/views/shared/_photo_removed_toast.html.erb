<%# Foto do álbum removida (AlbumPhotosController#destroy → flash[:photo_removed] = fotos que
    sobraram): "Foto removida — Você ainda tem N fotos no perfil." com Desfazer (volta a foto
    na mesma posição — #undo). Depois do Desfazer: flash "restored". Visual do mockup
    (shared/_top_toast, como o "Foto atualizada"). Locals: value %>
<% restored = value.to_s == "restored" %>
<% left = value.to_i %>
<% text = if restored then "Ela voltou para o mesmo lugar no seu perfil."
          elsif left.zero? then "Você não tem mais fotos no perfil."
          else "Você ainda tem #{left} #{left == 1 ? 'foto' : 'fotos'} no perfil."
          end %>
<%= render layout: "shared/top_toast", locals: {
      title: restored ? "Foto de volta" : "Foto removida", text: text,
      icon_class: "tt-icon--gold-dark", duration: restored ? 4500 : 7000, extra_class: "tt-toast--photo",
      action: (button_to("Desfazer", undo_album_photo_path, method: :post, class: "tt-action",
                         form: { class: "tt-action-form", data: { tt_keep: true } }) unless restored) } do %>
  <% if restored %>
    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/></svg>
  <% else %>
    <svg viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
  <% end %>
<% end %>
