<% if @remaining %>
  <%# Tela de Favoritos: o card sai, a contagem é refeita e, sem ninguém, entra o vazio %>
  <%= turbo_stream.remove "favorite-card-#{@favorite.favorited_user_id}" %>
  <%= turbo_stream.update "favorites-count", favorites_count_label(@remaining) %>
  <% if @remaining.zero? %>
    <%= turbo_stream.update "favorites-body", partial: "favorites/empty" %>
  <% end %>
<% else %>
  <%= turbo_stream.replace "favorite-btn-#{@favorite.favorited_user_id}" do %>
    <div id="<%= "favorite-btn-#{@favorite.favorited_user_id}" %>">
      <%= render "favorites/favorite_button", user: @favorite.favorited_user, favorite_id: nil %>
    </div>
  <% end %>
<% end %>
