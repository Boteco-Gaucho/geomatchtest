<%# Favoritos (/favorites) — layout do mockup: topo com contagem, grade de cards
    (só estrela e mensagem) ou o vazio com "Explorar cidades". Estilos: .fv-* em
    favorites.scss. Tirar a estrela aqui remove o card (destroy.turbo_stream). %>
<div class="favorites-screen">
  <div class="fv-header">
    <%= link_to discover_3d_gallery_path, class: "fv-back", aria: { label: "Voltar para Explorar cidades" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    <% end %>
    <div class="fv-heading">
      <h1 class="fv-title">Favoritos</h1>
      <p class="fv-subtitle" id="favorites-count"><%= favorites_count_label(@favorites.size) %></p>
    </div>
  </div>

  <div class="fv-body" id="favorites-body">
    <% if @favorites.any? %>
      <div class="fv-grid">
        <% @favorites.each do |favorite| %>
          <%= render "favorites/card", favorite: favorite %>
        <% end %>
      </div>
      <p class="fv-hint">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Toque na estrela para tirar alguém dos favoritos.
      </p>
    <% else %>
      <%= render "favorites/empty" %>
    <% end %>
  </div>
</div>
