<%# Card de perfil de "Explorar cidades" e de Favoritos (layout do mockup) %>
<% photo_url = user.avatar_url %>
<% location_text = [user.city, user.state].compact_blank.join(", ").presence || user.country.presence || "Localização oculta" %>
<% _parts = user.display_name.to_s.split; short_name = _parts.size > 1 ? "#{_parts.first} #{_parts.last}" : _parts.first.to_s %>

<article class="profile-card">
  <%= link_to user_path(user), class: "profile-card-link", aria: { label: "Ver perfil de #{user.display_name}" } do %>
    <%= image_tag photo_url, class: "profile-card-img", alt: user.display_name, loading: "lazy" %>
  <% end %>

  <div class="profile-card-overlay"></div>

  <% if user.plan&.name && %w[Plus Gold].include?(user.plan.name) %>
    <span class="profile-card-badge"><%= user.plan.name.upcase %></span>
  <% end %>

  <%# Favoritar — o Turbo Stream troca o div#favorite-btn-N inteiro, por isso a posição fica no pai %>
  <div class="profile-card-star">
    <div id="<%= "favorite-btn-#{user.id}" %>">
      <%= render "favorites/favorite_button", user: user, favorite_id: (favorites_map || {})[user.id] %>
    </div>
  </div>

  <div class="profile-card-info">
    <p class="profile-card-name">
      <% if user.online? && !user.invisible? %><span class="profile-card-online" title="Online agora"></span><% end %>
      <strong><%= short_name %></strong>
      <% if user.public_age %><span class="profile-card-age"><%= user.public_age %></span><% end %>
      <% if user.respond_to?(:verified?) && user.verified? %>
        <%= image_tag "icone-verificar.png", class: "verified-badge", alt: "Verificado" %>
      <% end %>
    </p>
    <p class="profile-card-location"><%= location_text %></p>
  </div>

  <div class="profile-card-actions">
    <%= button_to likes_path(user_id: user.id),
          method: :post,
          class: "card-action-btn card-action-fav",
          form: { class: "card-action-form" },
          title: "Curtir #{user.display_name}",
          aria: { label: "Curtir" } do %>
      <%= hidden_field_tag :source, "gallery" %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
    <% end %>

    <%= button_to start_chat_path(user_id: user.id),
          method: :post,
          class: "card-action-btn card-action-chat",
          form: { class: "card-action-form" },
          title: "Conversar com #{user.display_name}",
          aria: { label: "Enviar mensagem" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <% end %>
  </div>
</article>
