<%# Explorar cidades (/discover_3d/gallery) — layout do mockup.
    O olho daqui esconde só desta busca (users.hidden_from_city_search); o do mapa
    esconde só do mapa (users.invisible). Ver city_visibility_controller.js. %>
<div class="city-explorer">

  <%# --- TOPO --- %>
  <div class="ce-header">
    <%= link_to discover_3d_path, class: "ce-back", aria: { label: "Voltar ao mapa" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    <% end %>
    <div class="ce-heading">
      <h1 class="ce-title"><span class="ce-title-text">Explorar cidades</span> <span class="ce-gold-badge">GOLD</span></h1>
      <p class="ce-subtitle">Conheça pessoas de qualquer lugar</p>
    </div>

    <% hidden = current_user.hidden_from_city_search? %>
    <button type="button" class="ce-eye<%= ' is-hidden' if hidden %>"
            data-controller="city-visibility"
            data-action="city-visibility#toggle"
            data-city-visibility-url-value="<%= discover_3d_gallery_visibility_path %>"
            data-city-visibility-hidden-value="<%= hidden %>"
            aria-pressed="<%= hidden %>"
            aria-label="Ocultar meu perfil da busca por cidades">
      <svg class="ce-eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      <svg class="ce-eye-closed" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
    </button>
  </div>

  <%# Aviso do olho (preenchido pelo city_visibility_controller) %>
  <div class="ce-toast" id="ce-toast" role="status" aria-live="polite" hidden>
    <span class="ce-toast__icon"></span>
    <span class="ce-toast__text"><strong class="ce-toast__title"></strong><span class="ce-toast__body"></span></span>
    <button type="button" class="ce-toast__action" hidden></button>
  </div>

  <%# Modal de upgrade (Gold) — preenchido via JS quando necessário %>
  <div id="upgrade-modal-container" style="position: relative; z-index: 99999;"></div>

  <%= form_with url: discover_3d_gallery_path, method: :get, local: true, class: "ce-form",
                data: { controller: "gallery-filters location-filter", location_filter_current_city_value: @filters[:city].to_s } do |f| %>

    <%# --- ESTADO / CIDADE --- %>
    <div class="ce-selects">
      <label class="ce-select ce-select--state">
        <span class="ce-select-label">Estado</span>
        <%= f.select :state,
              options_for_select([ [ "Todos", "" ] ] + Discover3dHelper::BRAZIL_STATES.map { |uf, name| [ name, uf ] }, @filters[:state]),
              {}, class: "ce-select-input",
              data: { location_filter_target: "state", action: "change->gallery-filters#submit" } %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </label>
      <label class="ce-select">
        <span class="ce-select-label">Cidade</span>
        <%= f.select :city,
              options_for_select([ [ "Todas", "" ] ], @filters[:city]),
              {}, class: "ce-select-input", disabled: @filters[:state].blank?,
              data: { location_filter_target: "city", action: "change->gallery-filters#submit" } %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </label>
    </div>

    <%# --- CAPITAIS (carrossel contínuo; a lista vai duas vezes para emendar) --- %>
    <div class="ce-capitals" aria-label="Capitais do Brasil">
      <div class="ce-capitals-track">
        <% 2.times do |copy| %>
          <%= tag.ul class: "ce-capitals-list", aria: { hidden: (copy == 1 ? "true" : nil) } do %>
            <% Discover3dHelper::BRAZIL_CAPITALS.each do |name, uf| %>
              <li><%= link_to name, discover_3d_gallery_path(state: uf, city: name, sexo: @filters[:sexo]), tabindex: (copy == 1 ? -1 : nil) %></li>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# --- GÊNERO --- %>
    <div class="ce-segment" role="radiogroup" aria-label="Filtrar por gênero">
      <% [ [ "", "Todos" ], [ "homem", "Homens" ], [ "mulher", "Mulheres" ], [ "nao-binario", "Não binário" ] ].each do |value, label| %>
        <label class="ce-segment-opt">
          <%= f.radio_button :sexo, value, checked: @filters[:sexo].to_s.downcase == value,
                data: { action: "change->gallery-filters#submit" } %>
          <span><%= label %></span>
        </label>
      <% end %>
    </div>
  <% end %>

  <%# --- CONTAGEM + FAVORITOS --- %>
  <div class="ce-meta">
    <p class="ce-count"><strong><%= pluralize(@users.size, "pessoa", plural: "pessoas") %></strong> <%= city_search_place(@filters) %></p>
    <%= link_to favorites_path, class: "ce-favorites" do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      Favoritos
    <% end %>
  </div>

  <%# --- CARDS --- %>
  <% if @users.any? %>
    <div class="ce-grid">
      <% @users.each do |user| %>
        <%= render "discover3d/profile_card", user: user, favorites_map: @favorites_map %>
      <% end %>
    </div>
  <% else %>
    <div class="ce-empty">
      <h3>Ninguém por aqui ainda</h3>
      <p><%= @filters[:city].present? ? "Tente o estado inteiro ou outra capital da faixa acima." : "Escolha um estado ou uma capital para começar." %></p>
      <%= link_to "Limpar filtros", discover_3d_gallery_path, class: "ce-empty-btn" %>
    </div>
  <% end %>
</div>
