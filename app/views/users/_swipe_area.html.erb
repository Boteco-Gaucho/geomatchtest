<% if next_user %>

  <%# --- CARD DO USUÁRIO (layout do mockup; fotos no carrossel compartilhado) --- %>
  <div class="lead-card" data-lead-swipe-target="card" data-user-id="<%= next_user.id %>">

    <div class="card-gallery">
      <div class="swipe-overlay swipe-like" data-lead-swipe-target="like">
        <i class="fas fa-heart"></i>
      </div>
      <div class="swipe-overlay swipe-nope" data-lead-swipe-target="nope">
        <i class="fas fa-times"></i>
      </div>

      <%= render "shared/profile_carousel", user: next_user %>

      <%# "Ativa agora" só para quem está online de verdade %>
      <% if (online_label = online_now_label(next_user)) %>
        <span class="lead-online"><i></i><%= online_label %></span>
      <% end %>

      <%# Tocar nas informações (ou na seta) abre o perfil completo %>
      <div class="lead-info clickable-info" data-action="click->lead-swipe#openProfile">
        <h2 class="lead-name">
          <strong><%= next_user.display_name.split.first %></strong>
          <% if next_user.public_age %><span><%= next_user.public_age %></span><% end %>
          <% if next_user.verified? %>
            <svg class="lead-verified" viewBox="0 0 24 24" aria-label="Perfil verificado"><circle cx="12" cy="12" r="11"/><path d="M7 12.5l3.2 3.2L17 9"/></svg>
          <% end %>
        </h2>
        <% if (distance_label = nearby_distance_label(current_user, next_user)) %>
          <p class="lead-place">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <%= distance_label %>
          </p>
        <% end %>
        <% if next_user.bio.present? %>
          <p class="lead-bio"><%= next_user.bio %></p>
        <% end %>
        <% if next_user.hobbies_list.any? %>
          <ul class="lead-tags">
            <% next_user.hobbies_list.first(3).each do |hobby| %>
              <li><%= hobby %></li>
            <% end %>
          </ul>
        <% end %>
        <button type="button" class="lead-open-profile" aria-label="Ver perfil completo"
                data-action="lead-swipe#openProfile">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <%# --- BOTÕES DE AÇÃO (classes lead-*: as .btn-reject/.btn-like de lead.scss também
      vestem os botões do perfil público e do mapa, então não são usadas aqui) --- %>
  <div class="lead-actions">
    <%# Toast para "sem dislike para desfazer" (Turbo Stream de rewind) %>
    <div id="rewind-flash" class="rewind-flash-container"></div>

    <%# Rewind (desfazer último nope) — primeiro à esquerda %>
    <%= button_to rewind_lead_path, method: :post,
          class: "lead-btn lead-btn--rewind", form_class: "btn-form", aria: { label: "Desfazer" },
          data: { lead_swipe_target: "btnRewind" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
    <% end %>

    <%= button_to reject_user_path(user_id: next_user.id), method: :post,
          class: "lead-btn lead-btn--reject", form_class: "btn-form", aria: { label: "Passar" },
          data: { lead_swipe_target: "btnReject" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    <% end %>

    <%= button_to start_chat_path(user_id: next_user.id), method: :post,
          class: "lead-btn lead-btn--chat", form_class: "btn-form", aria: { label: "Mandar mensagem" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <% end %>

    <%= button_to likes_path(user_id: next_user.id), method: :post,
          class: "lead-btn lead-btn--like", form_class: "btn-form", aria: { label: "Curtir" },
          data: { lead_swipe_target: "btnLike" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
    <% end %>
  </div>

  <%# --- PERFIL COMPLETO (seta do card) — mesmo layout de /users/:id --- %>
  <div class="full-profile-sheet" data-lead-swipe-target="profileModal">
    <div class="profile-scroll-content">
      <%= render "users/full_profile", user: next_user, in_sheet: true %>
    </div>
  </div>

<% else %>
  <%# --- ACABARAM OS PERFIS (mockup): radar, os filtros ajustados em chips, "Ajustar filtros"
      (abre a folha de novo — filters#open) e "Ver quem está no mapa agora". Estilos .le-* em
      lead.scss. Também chega por Turbo Stream (rejeitar), por isso os filtros vêm da sessão. %>
  <% chips = LeadFilters.from_session(session, current_user).active_chips %>
  <div class="le-empty">
    <div class="le-radar" aria-hidden="true">
      <span class="le-ring le-ring--outer"></span>
      <span class="le-ring le-ring--inner"></span>
      <span class="le-dot le-dot--1"></span><span class="le-dot le-dot--2"></span><span class="le-dot le-dot--3"></span>
      <span class="le-core">
        <svg viewBox="0 0 24 24"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><path d="M14.6 8.4A3 3 0 1 0 15 11h-2.6"/><path d="M10.6 15.6l1.4 1.3 1.4-1.3"/></svg>
      </span>
    </div>

    <h2 class="le-title">Novas pessoas estão a caminho</h2>
    <p class="le-text">Gente nova entra no GeoMatch o tempo todo. Enquanto isso, amplie seus filtros ou espie quem está no mapa agora.</p>

    <% if chips.any? %>
      <ul class="le-chips" aria-label="Filtros ajustados">
        <% chips.each do |chip| %><li><%= chip %></li><% end %>
      </ul>
    <% end %>

    <div class="le-actions">
      <button type="button" class="le-adjust" data-action="filters#open">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16"/><circle cx="15" cy="8" r="2.4"/><circle cx="9" cy="16" r="2.4"/></svg>
        Ajustar filtros
      </button>
      <%= link_to discover_3d_path, class: "le-map" do %>
        <i aria-hidden="true"></i>Ver quem está no mapa agora
      <% end %>
    </div>
  </div>
<% end %>
