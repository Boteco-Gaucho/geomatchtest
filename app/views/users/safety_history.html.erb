<%# Bloqueados e denúncias (/safety_center/history) — layout do mockup. Usa o topo, as
    cores e as superfícies da Central de Segurança (.safety-center / .sc-*); o resto é
    .sh-* (safety_history.scss). Desbloquear: users#unblock, que volta para esta tela. %>
<% blocked = @blocked_users.to_a %>
<% reports = @my_reports.to_a %>
<% show_reported = Report.reported_user_column? %>
<div class="safety-center safety-history">

  <%# --- TOPO --- %>
  <div class="sc-header">
    <%= link_to safety_center_path, class: "sc-back", aria: { label: "Voltar" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    <% end %>
    <div class="sc-heading">
      <h1 class="sc-title"><span>Bloqueados e denúncias</span></h1>
      <p class="sc-subtitle">Quem você bloqueou e o que você relatou.</p>
    </div>
  </div>

  <%# --- BLOQUEADOS --- %>
  <section class="sh-section" aria-labelledby="sh-blocked-title">
    <div class="sh-head">
      <h2 class="sh-title" id="sh-blocked-title">Bloqueados</h2>
      <span class="sh-count"><%= blocked.empty? ? "Nenhum" : pluralize(blocked.size, "perfil", "perfis") %></span>
    </div>

    <% if blocked.any? %>
      <ul class="sh-card sh-list">
        <% blocked.each do |user| %>
          <li class="sh-blocked">
            <%= image_tag user.avatar_url, class: "sh-avatar", alt: "" %>
            <div class="sh-blocked-text">
              <strong><%= user.display_name %></strong>
              <span>Não vê seu perfil nem fala com você</span>
            </div>
            <%= button_to "Desbloquear", unblock_user_path(user),
                  method: :delete,
                  class: "sh-unblock",
                  form: { class: "sh-unblock-form",
                          data: { turbo_confirm: "Desbloquear #{user.display_name}? Vocês poderão se ver novamente." } } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="sh-card sh-empty">
        <span class="sh-empty-icon sh-empty-icon--neutral">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5.64 5.64l12.72 12.72"/></svg>
        </span>
        <strong class="sh-empty-title">Ninguém bloqueado</strong>
        <p class="sh-empty-text">Quando você bloquear alguém, o perfil aparece aqui.</p>
      </div>
    <% end %>
  </section>

  <%# --- MINHAS DENÚNCIAS (somente leitura) --- %>
  <section class="sh-section" aria-labelledby="sh-reports-title">
    <div class="sh-head">
      <h2 class="sh-title" id="sh-reports-title">Minhas denúncias</h2>
      <span class="sh-count"><%= reports.empty? ? "Nenhuma" : pluralize(reports.size, "enviada", "enviadas") %></span>
    </div>

    <% if reports.any? %>
      <ul class="sh-card sh-list">
        <% reports.each do |report| %>
          <% about = report.reported_user if show_reported %>
          <li class="sh-report">
            <div class="sh-report-top">
              <strong class="sh-report-kind"><%= Report::FORM_CATEGORIES.fetch(report.category, "Outro") %></strong>
              <% if report.resolved? %>
                <span class="sh-status sh-status--done">Analisada</span>
              <% else %>
                <span class="sh-status">Em análise</span>
              <% end %>
            </div>
            <p class="sh-report-meta">
              <%= report.created_at.strftime("%d/%m/%Y") %><% if about %> · sobre <%= about.display_name %><% end %>
            </p>
            <p class="sh-report-text"><%= truncate(report.description, length: 120) %></p>

            <% if report.photos.attached? %>
              <div class="sh-report-photos">
                <% report.photos.each do |photo| %>
                  <%= image_tag photo, class: "sh-report-thumb", alt: "" %>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="sh-card sh-empty">
        <span class="sh-empty-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 11.8l2.2 2.2 3.8-4"/></svg>
        </span>
        <strong class="sh-empty-title">Tudo tranquilo por aqui</strong>
        <p class="sh-empty-text">Quando você fizer uma denúncia, poderá acompanhar o andamento aqui.</p>
        <%= link_to "Fazer uma denúncia", report_incident_path, class: "sh-empty-link" %>
      </div>
    <% end %>

    <p class="sh-note">As denúncias ficam registradas e não podem ser editadas nem apagadas depois do envio.</p>
  </section>
</div>
