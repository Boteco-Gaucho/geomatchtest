<%# Card e botões no layout do mockup (fonte Inter, estilos .lead-* em lead.scss).
    Logo e barra de navegação de baixo seguem como eram. %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<% end %>

<% filter_defaults = LeadFilters.defaults(current_user) %>
<div class="geomatch-screen-wrapper" data-controller="lead-swipe filters"
     data-filters-default-genders-value="<%= filter_defaults.genders.to_json %>"
     data-filters-default-distance-value="<%= filter_defaults.distance %>"
     data-filters-default-min-age-value="<%= filter_defaults.min_age %>"
     data-filters-default-max-age-value="<%= filter_defaults.max_age %>">
  
  <%# --- 1. HEADER (Fixo) --- %>
  <div class="geomatch-header">
    <div class="header-left">
      <%= image_tag "logo-geomatch-dourada.png", class: "header-logo", alt: "GeoMatch" %>
    </div>
    <%# Só filtros, como no mockup — o tema claro/escuro fica em Meu Perfil → Aparência %>
    <div class="header-right">
      <% active_filters = @lead_filters.active_count %>
      <button type="button" class="header-btn lead-filter-btn"
              aria-label="<%= active_filters.positive? ? "Filtros (#{active_filters} ajustados)" : "Filtros" %>" data-action="click->filters#open">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16"/><circle cx="15" cy="8" r="2.4"/><circle cx="9" cy="16" r="2.4"/></svg>
        <%# Quantos filtros a pessoa ajustou (LeadFilters#active_count — os chips do fim dos perfis) %>
        <% if active_filters.positive? %><span class="lead-filter-count" aria-hidden="true"><%= active_filters %></span><% end %>
      </button>
    </div>
  </div>

  <%# --- 3. ÁREA PRINCIPAL (Cards) — alvo do Turbo Stream de rewind --- %>
  <div class="geomatch-main-area" id="swipe-area">
    <%= render "users/swipe_area", next_user: @next_user, distance: @distance %>
  </div>

  <%# --- 5. FILTROS (folha de baixo) — LeadFilters na sessão; filters_controller.js atualiza
      valores, "N ativos" e os contadores enquanto a pessoa mexe. Estilos .lf-* em lead.scss. %>
  <% lf = @lead_filters %>
  <div class="filter-modal lf-modal hidden" data-filters-target="modal">
    <div class="filter-backdrop" data-action="click->filters#close"></div>

    <div class="lf-sheet" role="dialog" aria-modal="true" aria-labelledby="lf-title">
      <%= form_tag lead_path, method: :get, class: "lf-form", data: { filters_target: "form", action: "input->filters#refresh change->filters#refresh" } do %>
        <span class="lf-handle" aria-hidden="true"></span>

        <div class="lf-head">
          <h2 class="lf-title" id="lf-title">Filtros</h2>
          <span class="lf-active" data-filters-target="activeBadge" <%= "hidden" if lf.active_count.zero? %>>
            <%= lf.active_count %> <%= lf.active_count == 1 ? "ativo" : "ativos" %>
          </span>
          <button type="button" class="lf-close" aria-label="Fechar filtros" data-action="filters#close">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>

        <div class="lf-scroll">
          <%# Quero conhecer %>
          <section class="lf-card">
            <h3 class="lf-card-title">Quero conhecer</h3>
            <div class="lf-chips">
              <% LeadFilters::GENDERS.each do |key, gender| %>
                <label class="lf-chip">
                  <input type="checkbox" name="f[genders][]" value="<%= key %>" <%= "checked" if lf.genders.include?(key) %>
                         data-filters-target="gender">
                  <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><%= gender[:label] %></span>
                </label>
              <% end %>
            </div>
            <%# Sem nenhum marcado = todos (a chave vai vazia para não cair no padrão do perfil) %>
            <input type="hidden" name="f[genders][]" value="">
          </section>

          <%# Distância máxima %>
          <section class="lf-card">
            <div class="lf-card-head">
              <h3 class="lf-card-title">Distância máxima</h3>
              <span class="lf-value">até <span data-filters-target="distanceValue"><%= lf.distance %></span> km</span>
            </div>
            <div class="lf-range" data-filters-target="distanceRange">
              <input type="range" name="f[distance]" min="<%= LeadFilters::DISTANCE_RANGE.min %>" max="<%= LeadFilters::DISTANCE_RANGE.max %>"
                     step="1" value="<%= lf.distance %>" aria-label="Distância máxima em km" data-filters-target="distance">
            </div>
            <div class="lf-range-ends"><span><%= LeadFilters::DISTANCE_RANGE.min %> km</span><span><%= LeadFilters::DISTANCE_RANGE.max %> km</span></div>
            <div class="lf-row lf-row--divided">
              <span class="lf-row-text"><strong>Ampliar se acabarem os perfis</strong><small>Mostra pessoas um pouco mais longe.</small></span>
              <input type="hidden" name="f[expand]" value="0">
              <label class="lf-switch"><input type="checkbox" name="f[expand]" value="1" <%= "checked" if lf.expand %> aria-label="Ampliar se acabarem os perfis"><span></span></label>
            </div>
          </section>

          <%# Faixa etária (duas pontas no mesmo trilho) %>
          <section class="lf-card">
            <div class="lf-card-head">
              <h3 class="lf-card-title">Faixa etária</h3>
              <span class="lf-value"><span data-filters-target="ageValue"><%= lf.min_age %> – <%= lf.max_age %></span> anos</span>
            </div>
            <div class="lf-range lf-range--dual" data-filters-target="ageRange">
              <input type="range" name="f[min_age]" min="<%= LeadFilters::AGE_RANGE.min %>" max="<%= LeadFilters::AGE_RANGE.max %>"
                     value="<%= lf.min_age %>" aria-label="Idade mínima" data-filters-target="minAge">
              <input type="range" name="f[max_age]" min="<%= LeadFilters::AGE_RANGE.min %>" max="<%= LeadFilters::AGE_RANGE.max %>"
                     value="<%= lf.max_age %>" aria-label="Idade máxima" data-filters-target="maxAge">
            </div>
            <div class="lf-range-ends"><span><%= LeadFilters::AGE_RANGE.min %></span><span><%= LeadFilters::AGE_RANGE.max %></span></div>
          </section>

          <%# Interesses em comum %>
          <section class="lf-card">
            <div class="lf-card-head">
              <h3 class="lf-card-title">Interesses em comum</h3>
              <span class="lf-value" data-filters-target="interestsCount" <%= "hidden" if lf.interests.empty? %>>
                <%= lf.interests.size %> <%= lf.interests.size == 1 ? "selecionado" : "selecionados" %>
              </span>
            </div>
            <div class="lf-chips">
              <% LeadFilters::INTERESTS.each do |key, interest| %>
                <label class="lf-chip lf-chip--plain">
                  <input type="checkbox" name="f[interests][]" value="<%= key %>" <%= "checked" if lf.interests.include?(key) %>
                         data-filters-target="interest">
                  <span><%= interest[:label] %></span>
                </label>
              <% end %>
            </div>
            <p class="lf-note">Mostra quem tem pelo menos um desses no perfil.</p>
          </section>

          <%# Mais filtros %>
          <section class="lf-card">
            <h3 class="lf-card-title">Mais filtros</h3>
            <% [ [ "online", "Online agora", "Só quem está usando o app", lf.online ],
                 [ "verified", "Só perfis verificados", "Com o selo azul", lf.verified ],
                 [ "with_bio", "Com bio preenchida", "Perfis que contam algo sobre si", lf.with_bio ] ].each_with_index do |(key, title, sub, on), i| %>
              <div class="lf-row<%= " lf-row--divided" if i.positive? %>">
                <span class="lf-icon lf-icon--<%= key %>" aria-hidden="true">
                  <% case key
                     when "online" %><i></i>
                  <% when "verified" %><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.4l3 2.9 6-6.1"/></svg>
                  <% else %><svg viewBox="0 0 24 24"><path d="M5 7h14M5 12h14M5 17h9"/></svg>
                  <% end %>
                </span>
                <span class="lf-row-text"><strong><%= title %></strong><small><%= sub %></small></span>
                <input type="hidden" name="f[<%= key %>]" value="0">
                <label class="lf-switch"><input type="checkbox" name="f[<%= key %>]" value="1" <%= "checked" if on %>
                       aria-label="<%= title %>" data-filters-target="toggle"><span></span></label>
              </div>
            <% end %>
          </section>
        </div>

        <div class="lf-actions">
          <%= link_to "Limpar", lead_path(limpar_filtros: 1), class: "lf-clear" %>
          <button type="submit" class="lf-apply">Aplicar filtros</button>
        </div>
      <% end %>
    </div>
  </div>
<div id="upgrade-modal-container" style="position: relative; z-index: 99999;"></div>
</div>