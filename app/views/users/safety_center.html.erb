<%# Central de Segurança — layout do mockup.
    Ligar 190 é um link tel:; "Compartilhar local" e "Modo Pânico" ficam no
    safety_center_controller.js (GPS + folha de compartilhamento, com painel de reserva). %>
<div class="safety-center" data-controller="safety-center"
     data-safety-center-name-value="<%= current_user.display_name.to_s.strip %>"
     data-action="turbo:before-cache@document->safety-center#reset keydown.esc@window->safety-center#closeSheet">

  <%# --- 1. TOPO --- %>
  <div class="sc-header">
    <%= link_to my_profile_path, class: "sc-back", aria: { label: "Voltar" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    <% end %>
    <div class="sc-heading">
      <h1 class="sc-title"><span>Central de Segurança</span></h1>
      <p class="sc-subtitle">Segurança a um toque de distância.</p>
    </div>
  </div>

  <%# --- 2. EMERGÊNCIA --- %>
  <%= link_to "tel:190", class: "sc-call", aria: { label: "Ligar 190, Polícia" } do %>
    <svg class="sc-call-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span class="sc-call-label">Ligar 190</span>
    <span class="sc-call-tag">Polícia</span>
  <% end %>

  <%# --- 3. OUTRAS AÇÕES --- %>
  <h2 class="sc-section-title">Outras ações</h2>

  <div class="sc-grid">
    <button type="button" class="sc-card" data-action="safety-center#shareLocation">
      <span class="sc-tile sc-tile--green">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
      </span>
      <strong class="sc-card-title">Compartilhar local</strong>
      <span class="sc-card-text" data-safety-center-target="shareStatus">Enviar localização atual</span>
    </button>

    <%= link_to report_incident_path, class: "sc-card" do %>
      <span class="sc-tile sc-tile--peach">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 21V3.5"/><path d="M6 3.5h12l-3.5 4.75L18 13H6"/></svg>
      </span>
      <strong class="sc-card-title">Denunciar</strong>
      <span class="sc-card-text">Reportar um incidente</span>
    <% end %>
  </div>

  <button type="button" class="sc-row" data-action="safety-center#panic">
    <span class="sc-tile sc-tile--red">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21h4"/></svg>
    </span>
    <span class="sc-row-text">
      <strong>Modo Pânico</strong>
      <span data-safety-center-target="panicStatus">Enviar alerta de emergência</span>
    </span>
    <svg class="sc-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
  </button>

  <%= link_to safety_history_path, class: "sc-row" do %>
    <span class="sc-tile sc-tile--sand">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5.64 5.64l12.72 12.72"/></svg>
    </span>
    <span class="sc-row-text">
      <strong>Bloqueados e denúncias</strong>
      <span>Perfis bloqueados e status das denúncias</span>
    </span>
    <svg class="sc-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
  <% end %>

  <%# --- 4. DICAS --- %>
  <section class="sc-tips" aria-labelledby="sc-tips-title">
    <h2 class="sc-tips-title" id="sc-tips-title">Dicas para se sentir à vontade</h2>
    <p class="sc-tips-intro">Pequenos cuidados que deixam cada encontro mais tranquilo.</p>

    <ol class="sc-tips-list">
      <% [
        [ "Confie no seu instinto", "Se algo não parecer certo, tudo bem encerrar a conversa ou ir embora." ],
        [ "Prefira lugares movimentados", "Nos primeiros encontros, escolha um lugar público e avise alguém de confiança." ],
        [ "Conte com a gente", "As ações desta tela estão sempre a um toque, quando você precisar." ],
        [ "Nos conte o que aconteceu", "Sua denúncia é confidencial e ajuda a manter a comunidade segura." ]
      ].each.with_index(1) do |(title, text), number| %>
        <li class="sc-tip">
          <span class="sc-tip-number" aria-hidden="true"><%= format("%02d", number) %></span>
          <div>
            <strong class="sc-tip-title"><%= title %></strong>
            <p class="sc-tip-text"><%= text %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </section>

  <%# --- Painel de reserva: o navegador não abriu a folha de compartilhamento
         (sem suporte, ou recusou porque o GPS respondeu depois do toque) --- %>
  <div class="sc-sheet" data-safety-center-target="sheet" hidden>
    <div class="sc-sheet-backdrop" data-action="click->safety-center#closeSheet"></div>
    <div class="sc-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="sc-sheet-title">
      <h3 class="sc-sheet-title" id="sc-sheet-title" data-safety-center-target="sheetTitle"></h3>
      <p class="sc-sheet-message" data-safety-center-target="sheetMessage"></p>
      <a class="sc-sheet-btn sc-sheet-btn--primary" data-safety-center-target="whatsapp"
         data-action="safety-center#closeSheet" target="_blank" rel="noopener">Enviar pelo WhatsApp</a>
      <button type="button" class="sc-sheet-btn" data-action="safety-center#copy">Copiar mensagem</button>
      <button type="button" class="sc-sheet-btn" data-safety-center-target="moreOptions"
              data-action="safety-center#moreOptions">Outras opções</button>
      <button type="button" class="sc-sheet-cancel" data-action="safety-center#closeSheet">Cancelar</button>
    </div>
  </div>
</div>
