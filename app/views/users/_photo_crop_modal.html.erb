<%# Ajuste da foto (Editar perfil) — abre assim que a pessoa escolhe uma foto, principal ou do
    álbum (photo_crop_controller.js). Quadro 3:4 (a proporção do perfil), arrastar, pinça,
    barra de zoom (dá para afastar até caber a foto inteira), girar 90° e grade guia.
    Confirmar gera a foto recortada (JPEG 1080×1440) no navegador e só então envia.
    Visual da tela de recorte antiga (.gm-crop, _crop_screen.scss). %>
<div class="gm-crop gm-crop--modal" hidden data-photo-crop-target="modal" role="dialog" aria-modal="true" aria-labelledby="gm-crop-title"
     data-action="keydown.esc@window->photo-crop#cancel">
  <header class="gm-crop__header">
    <button type="button" class="gm-crop__btn gm-crop__btn--cancel" data-action="photo-crop#cancel">Cancelar</button>
    <h1 class="gm-crop__title" id="gm-crop-title" data-photo-crop-target="title">Ajustar foto</h1>
    <button type="button" class="gm-crop__btn gm-crop__btn--confirm" data-photo-crop-target="confirm"
            data-action="photo-crop#confirm">Confirmar</button>
  </header>

  <div class="gm-crop__wrap" data-photo-crop-target="wrap">
    <div class="gm-crop__photo-area">
      <img class="gm-crop__photo" data-photo-crop-target="photo" alt="" draggable="false">
    </div>
    <div class="gm-crop__box" data-photo-crop-target="box" style="aspect-ratio: 3/4;">
      <span class="gm-crop__corner gm-crop__corner--tl"></span>
      <span class="gm-crop__corner gm-crop__corner--tr"></span>
      <span class="gm-crop__corner gm-crop__corner--bl"></span>
      <span class="gm-crop__corner gm-crop__corner--br"></span>
    </div>
  </div>

  <footer class="gm-crop__footer gm-crop__footer--zoom">
    <div class="gm-crop__zoom">
      <button type="button" class="gm-crop__tool" aria-label="Diminuir zoom" data-action="photo-crop#zoomOut">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg>
      </button>
      <input type="range" class="gm-crop__range" min="0" max="1000" step="1" value="0" aria-label="Zoom"
             data-photo-crop-target="zoom" data-action="input->photo-crop#slide">
      <button type="button" class="gm-crop__tool" aria-label="Aumentar zoom" data-action="photo-crop#zoomIn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <button type="button" class="gm-crop__tool" aria-label="Girar 90 graus" data-action="photo-crop#rotate">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
      </button>
    </div>
    <p class="gm-crop__hint">Arraste para posicionar · Pinça ou a barra para o zoom</p>
  </footer>
</div>
