<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>
<style>
  #map-3d { opacity: 1; }
</style>

<div id="assets-data"
     data-frame-url="<%= image_path('aurea-dourada-mensagens.svg') %>"
     data-verified-url="<%= image_path('icone-verificar.png') %>"
     style="display: none;"></div>

<div id="current-user-data" data-invisible="<%= current_user.invisible %>" data-sharing-location="<%= current_user.sharing_location? %>"
     data-hobbies="<%= current_user.hobbies_list.map { |h| h.strip.downcase }.to_json %>"></div>

<div class="discover-fullscreen-container">

  <%#
    data-user-lat / data-user-lng: coords do banco (Prioridade 2 na hierarquia de localização).
    Usadas quando o GPS é negado, demora ou o usuário não tem geolocation.
    to_f garante que nil vira 0.0 — o JS checa por valores válidos antes de usar.
  %>
  <div class="map-wrapper" data-controller="map-loader" style="position: relative; width: 100%; height: 100vh;">
    <%= render "shared/map_loading" %>
    <div id="map-3d" class="map-fullscreen"
         data-user-lat="<%= current_user.latitude.to_f %>"
         data-user-lng="<%= current_user.longitude.to_f %>"
         data-map-loader-target="map"></div>
  </div>

  <div class="discover-header-floating">
    <div class="header-left">
      <%= image_tag "logo-geomatch-dourada.png", class: "header-logo-img" %>
    </div>
    <div class="header-right">
      <%= render "gender_filter", selected: "all" %>
    </div>
  </div>

  <%# Raio da busca: pílula branca com o valor em cima e o trilho vertical %>
  <div class="radar-control-floating">
    <span class="radar-value"><strong id="range-value-text">150</strong>m</span>
    <div class="slider-track-container">
      <input type="range" id="radar-range" min="1" max="300" value="150" step="1"
             class="range-slider-custom" aria-label="Raio da busca em metros">
    </div>
  </div>

  <%# Avisos dos botões (tempo real, modo oculto) — preenchido por showMapToast em map_3d.js %>
  <%= render "shared/map_toast" %>

  <div class="map-fab-container">
    <%# Tempo real: seta cheia = ligado; seta riscada (.is-off) = desligado %>
    <button type="button" class="fab-button" id="fab-live-tracking" title="Visibilidade em tempo real" aria-label="Visibilidade em tempo real">
      <svg class="icon-on" viewBox="0 0 24 24" aria-hidden="true"><polygon points="3 11 22 2 13 21 11 13 3 11" fill="currentColor"/></svg>
      <svg class="icon-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.43 8.43 3 11l8 2 2 8 2.57-5.43"/><path d="M17.39 11.73 22 2l-9.73 4.61"/><path d="M2 2l20 20"/></svg>
    </button>

    <%# Modo oculto (Gold): olho = visível no mapa; olho riscado = oculto %>
    <button type="button" id="toggle-visibility-btn" class="fab-button fab-visibility" title="Modo oculto" aria-label="Modo oculto">
      <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      <svg class="eye-closed hidden" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
    </button>

    <button type="button" class="fab-button" id="fab-center-map" title="Centralizar no meu local" aria-label="Centralizar no meu local">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h3M19 12h3M12 2v3M12 19v3"/><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5" fill="currentColor"/></svg>
    </button>

    <%= link_to discover_3d_gallery_path, class: "fab-button fab-gallery", title: "Busca por cidade", aria: { label: "Busca por cidade" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
    <% end %>
  </div>

  <%# --- POR PERTO AGORA: gaveta de baixo (map_3d.js monta a faixa, a lista e o vazio).
      Recolhida: faixa de avatares (ou o cartão "Ninguém no seu raio agora"). Aberta (arrastar
      ou tocar na alça): chips Todos / Verificados / Interesses em comum e a lista com mensagem;
      vazia, o radar e "Enquanto isso". Estilos .nb-* em discover.scss. %>
  <div class="users-bottom-sheet nb-sheet">
    <div class="bottom-sheet-handle" role="button" tabindex="0" aria-label="Abrir ou fechar a lista de quem está por perto">
      <div class="handle-bar"></div>
    </div>

    <div class="nb-head">
      <h2 class="nb-title"><i aria-hidden="true"></i>Por perto agora</h2>
      <span class="nb-count" id="nearby-count" aria-live="polite">Procurando...</span>
    </div>

    <div class="nb-chips" id="nearby-chips" role="group" aria-label="Filtrar quem está por perto" hidden>
      <button type="button" class="nb-chip is-active" data-nearby-chip="all" aria-pressed="true">Todos</button>
      <button type="button" class="nb-chip" data-nearby-chip="verified" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.4l3 2.9 6-6.1"/></svg>Verificados
      </button>
      <button type="button" class="nb-chip" data-nearby-chip="interests" aria-pressed="false">Interesses em comum</button>
    </div>

    <div class="nb-body">
      <ul class="nb-strip" id="nearby-strip" aria-label="Quem está por perto"></ul>
      <ul class="nb-list users-list-fullscreen" id="users-list"></ul>
      <p class="nb-none" id="nearby-none" hidden>Ninguém com esse filtro agora.</p>

      <div class="nb-empty" id="nearby-empty" hidden>
        <div class="nb-empty-card">
          <span class="nb-radar nb-radar--sm" aria-hidden="true"><span></span><b><%= render "users/nearby_pin" %></b></span>
          <span class="nb-empty-card-text">
            <strong>Ninguém no seu raio agora</strong>
            <span>Fique de olho: quem chegar a até 300 m aparece aqui na hora.</span>
          </span>
        </div>

        <div class="nb-empty-more">
          <span class="nb-radar nb-radar--lg" aria-hidden="true"><span></span><b><%= render "users/nearby_pin" %></b></span>
          <h3 class="nb-empty-title">Ninguém no seu raio agora</h3>
          <p class="nb-empty-text">O GeoMatch é ao vivo: quando alguém chegar a até 300 m de você, aparece aqui na hora.</p>

          <p class="nb-kicker">Enquanto isso</p>
          <%= link_to discover_3d_gallery_path, class: "nb-option" do %>
            <span class="nb-option-icon nb-option-icon--dark" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5"/><path d="M12 2.5a14 14 0 0 0 0 19 14 14 0 0 0 0-19M2.5 12h19"/></svg>
            </span>
            <span class="nb-option-text">
              <strong>Explorar outras cidades <em>Gold</em></strong>
              <small>Converse com gente de qualquer lugar do Brasil</small>
            </span>
            <svg class="nb-option-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          <% end %>
          <%= link_to lead_path, class: "nb-option" do %>
            <span class="nb-option-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </span>
            <span class="nb-option-text">
              <strong>Ver perfis no Início</strong>
              <small>Curta e converse com quem está mais longe</small>
            </span>
            <svg class="nb-option-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          <% end %>

          <p class="nb-foot nb-foot--live">
            <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 0 0-14.3-4.9L4 8"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0 0 14.3 4.9L20 16"/><path d="M20 20v-4h-4"/></svg></span>
            Sem pressa: o mapa se atualiza ao vivo.
          </p>
        </div>
      </div>
    </div>

    <p class="nb-foot nb-foot--list" id="nearby-foot" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/></svg>
      Distâncias aproximadas para proteger todo mundo
    </p>
  </div>

  <%# --- PERFIL COMPLETO: folha que sobe por cima do mapa ("Ver perfil" da prévia do pin).
      O map_3d.js busca GET /users/:id?context=map (users/_full_profile com in_map) e põe
      aqui dentro. Estilos .map-profile-* em map_profile.scss. %>
  <div id="user-popup" class="map-profile" hidden>
    <div class="map-profile-overlay" data-map-profile-close></div>
    <div class="map-profile-sheet" role="dialog" aria-modal="true" aria-label="Perfil" tabindex="-1">
      <div class="map-profile-body" id="map-profile-body"></div>
    </div>
  </div>

  <%# --- PRÉVIA DO PIN: cartão em cima do pin da pessoa (map_3d.js preenche e posiciona).
      Estilos .pin-card-* em map_profile.scss. %>
  <div id="mini-card-overlay" class="pin-card" hidden>
    <div class="pin-card-photo">
      <%# Uma <img> por foto, em camadas (map_3d.js mountPinCardPhotos) %>
      <div class="pin-card-layers" id="pin-card-layers"></div>
      <svg class="pin-card-placeholder" viewBox="0 0 114 118" aria-hidden="true"><circle cx="57" cy="28.5" r="25.5"/><path d="M3 115A54 51 0 0 1 111 115"/></svg>
      <span class="pin-card-tap pin-card-tap--prev" id="pin-card-prev" aria-hidden="true"></span>
      <span class="pin-card-tap pin-card-tap--next" id="pin-card-next" aria-hidden="true"></span>
      <span class="pin-card-online" id="pin-card-online" hidden><i></i>Online</span>
      <button type="button" class="pin-card-close" id="pin-card-close" aria-label="Fechar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div class="pin-card-bars" id="pin-card-bars" aria-hidden="true"></div>
    </div>

    <div class="pin-card-body">
      <p class="pin-card-name">
        <strong id="pin-card-name"></strong><span id="pin-card-age"></span>
        <svg class="pin-card-verified" id="pin-card-verified" viewBox="0 0 24 24" role="img" aria-label="Perfil verificado" hidden><circle cx="12" cy="12" r="12"/><path d="M7.2 12.4l3.2 3.1 6.4-6.6"/></svg>
      </p>
      <p class="pin-card-distance">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="pin-card-distance"></span>
      </p>

      <div class="pin-card-actions">
        <button type="button" class="pin-card-view" id="pin-card-view">Ver perfil</button>
        <%# user_id=0: o map_3d.js troca pelo id da pessoa antes de mostrar %>
        <%= button_to start_chat_path(user_id: 0), method: :post, class: "pin-card-round pin-card-chat",
              form: { id: "pin-card-chat-form", class: "pin-card-form" },
              aria: { label: "Mandar mensagem" }, title: "Mandar mensagem" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <% end %>
        <%# Curtir / desfazer por alguns segundos — o map_3d.js troca a pessoa (like-toggle:load) %>
        <span id="pin-card-like-slot">
          <%= render "shared/like_toggle", classes: "pin-card-round pin-card-like", user_id: 0 %>
        </span>
      </div>
    </div>
    <span class="pin-card-arrow" aria-hidden="true"></span>
  </div>

  <div id="upgrade-modal-container" style="position: relative; z-index: 99999;"></div>

  <%# --- GENDER HUD --- %>
  <div id="gender-hud" class="gender-hud">
    <%# Gradient referenced by all JS-injected gender SVG icons %>
    <svg width="0" height="0" style="position:absolute; overflow:hidden;">
      <defs>
        <%# userSpaceOnUse: gradiente em objectBoundingBox não renderiza em linhas
            retas (bbox de área zero) — as hastes dos símbolos ♀/⚥ sumiriam %>
        <linearGradient id="gm-gold-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="24" y2="0">
          <stop offset="0%" stop-color="#F4DFC4"/>
          <stop offset="100%" stop-color="#C9A079"/>
        </linearGradient>
      </defs>
    </svg>
    <div id="gender-hud-icons" class="gender-hud__icons"></div>
    <p id="gender-hud-label" class="gender-hud__label"></p>
  </div>
</div>

<%= javascript_include_tag "live_location", type: "module" %>
<%= javascript_include_tag "map_3d", type: "module" %>
