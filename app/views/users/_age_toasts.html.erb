<%# Avisos do "Não mostrar minha idade" (Meu Perfil): o privacy_toggle_controller copia o
    <template> do novo estado para a página quando o servidor confirma a mudança. %>
<template data-privacy-toggle-target="onToast">
  <%= render layout: "shared/top_toast", locals: {
        title: "Sua idade está escondida",
        text: "Ninguém vê sua idade no seu perfil. Volte a mostrar quando quiser.",
        icon_class: "tt-icon--age-hidden" } do %>
    <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M8 3v4M16 3v4M3.5 10h17"/><path d="M10.6 13.4a1.5 1.5 0 1 1 2.1 1.4c-.45.2-.7.55-.7 1v.2"/><path d="M12 18.1v.01"/></svg>
  <% end %>
</template>
<template data-privacy-toggle-target="offToast">
  <%= render layout: "shared/top_toast", locals: {
        title: "Sua idade voltou a aparecer",
        text: "Quem abrir seu perfil já vê sua idade. Esconda de novo quando quiser.",
        icon_class: "tt-icon--age-shown" } do %>
    <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M8 3v4M16 3v4M3.5 10h17"/><% if age.present? %><text x="12" y="17.6" text-anchor="middle"><%= age %></text><% end %></svg>
  <% end %>
</template>
