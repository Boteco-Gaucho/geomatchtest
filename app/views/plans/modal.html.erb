<%# Modal de upgrade para o Gold — buscado por JS (/plans/modal?type=…) e injetado no
    #upgrade-modal-container: upgrade_modal.js (mapa, Explorar cidades) e
    visibility_toggle_controller.js (Modo oculto de Meu Perfil). Layout do mockup;
    estilos .um-* em upgrade_modal.scss. Fecham o modal: o X, "Agora não" e o
    toque fora (todos com .close-modal-btn / no .upgrade-modal-backdrop). %>
<% invisible = @feature_type == "invisible" %>

<div class="upgrade-modal-backdrop">
  <div class="upgrade-modal-content um-card" role="dialog" aria-modal="true" aria-labelledby="um-title">
    <button type="button" class="close-modal-btn um-close" aria-label="Fechar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>

    <div class="um-icon" aria-hidden="true">
      <% if invisible %>
        <svg viewBox="0 0 24 24"><path d="M12 2.5a7.5 7.5 0 0 0-7.5 7.5v11l2.5-2 2.5 2 2.5-2 2.5 2 2.5-2 2.5 2V10A7.5 7.5 0 0 0 12 2.5z"/><path d="M9.5 10.5v1M14.5 10.5v1"/></svg>
      <% else %>
        <svg viewBox="0 0 24 24"><path d="M2 8l4 11h12l4-11-5.5 4L12 4l-4.5 8L2 8z"/></svg>
      <% end %>
    </div>

    <h2 class="um-title" id="um-title">
      <% if invisible %>
        Fique invisível com o <span>Gold</span>
      <% else %>
        Desbloqueie tudo com o <span>Gold</span>
      <% end %>
    </h2>

    <p class="um-text">
      <% if invisible %>
        Veja quem está por perto sem aparecer no mapa. Você decide quando ser visto.
      <% else %>
        Mapa sem limites, mensagens ilimitadas e todos os recursos exclusivos.
      <% end %>
    </p>

    <ul class="um-perks">
      <% [ "Modo oculto no mapa", "Ver quem curtiu você", "Mensagens ilimitadas", "Explorar outras cidades" ].each do |perk| %>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11"/><path d="M7.5 12.3l3 3 6-6.3"/></svg>
          <%= perk %>
        </li>
      <% end %>
    </ul>

    <% if @gold_plan %>
      <%# Mesmo fluxo de /plans: POST /checkout sem Turbo -> Mercado Pago %>
      <%= button_to "Assinar Gold", checkout_path(plan_id: @gold_plan.id), method: :post,
                    form: { class: "um-cta-form", data: { turbo: false } }, class: "um-cta" %>
      <p class="um-price"><%= plan_price_label(@gold_plan) %>/mês · cancele quando quiser</p>
    <% else %>
      <%= link_to "Ver planos", plans_path(anchor: "plano-gold"), class: "um-cta" %>
      <p class="um-price">Cancele quando quiser</p>
    <% end %>

    <button type="button" class="close-modal-btn um-later">Agora não</button>
  </div>
</div>
