<%# Planos (/plans) — layout do mockup: tela escura, título "Desbloqueie o melhor
    do GeoMatch", um card por plano (do mais caro ao mais barato) e o aviso do
    checkout. Os cards de /meu-perfil abrem aqui já no plano (#plano-<code>).
    Estilos: .pl-* em plans.scss. %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<% end %>

<% plans = Array(@plans).compact.sort_by { |plan| -plan.price_cents.to_i } %>
<%# "Recomendado": o plano marcado no banco; sem nenhum marcado, o Plus %>
<% recommended = plans.find { |plan| plan.try(:is_recommended) } || plans.find { |plan| plan.code == "plus" } %>

<div class="plans-screen">
  <header class="pl-header">
    <%= link_to (user_signed_in? ? my_profile_path : root_path), class: "pl-back", aria: { label: "Voltar" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    <% end %>

    <h1 class="pl-title">Desbloqueie o<br> <span>melhor do GeoMatch</span></h1>
    <p class="pl-subtitle">Mais conexões, mais liberdade e privacidade do seu jeito.</p>

    <ul class="pl-trust">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        Pagamento seguro via Mercado Pago
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
        Cancele quando quiser
      </li>
    </ul>
  </header>

  <% if plans.empty? %>
    <p class="pl-empty">Nenhum plano disponível no momento.</p>
  <% else %>
    <div class="pl-list">
      <% plans.each do |plan| %>
        <% theme      = plan_theme(plan) %>
        <% is_current = current_user && current_user.plan_id == plan.id %>
        <% cta_kind, cta_label = plan_page_cta(plan, current_user) %>

        <article class="pl-card pl-card--<%= theme %>" id="plano-<%= plan.code %>">
          <div class="pl-card-top">
            <h2 class="pl-name"><%= plan.name %></h2>
            <% if is_current %>
              <span class="pl-tag pl-tag--current">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                Seu plano
              </span>
            <% elsif plan == recommended %>
              <span class="pl-tag pl-tag--recommended">Recomendado</span>
            <% end %>
          </div>

          <p class="pl-price">
            <strong><%= plan_price_label(plan) %></strong>
            <span><%= plan.price_cents.to_i.zero? ? "para sempre" : "/mês" %></span>
          </p>

          <% if (tagline = plan_tagline(plan)).present? %>
            <p class="pl-tagline"><%= tagline %></p>
          <% end %>

          <% unless theme == "free" %>
            <ul class="pl-perks">
              <% PlansHelper::PLANS_PAGE_PERKS.each do |label, key| %>
                <% included = plan_page_perk?(plan, key) %>
                <li class="<%= included ? 'is-yes' : 'is-no' %>">
                  <% if included %>
                    <svg class="pl-perk-check" viewBox="0 0 24 24" aria-label="Incluído"><circle cx="12" cy="12" r="11"/><path d="M7.5 12.3l3 3 6-6.3"/></svg>
                  <% else %>
                    <svg class="pl-perk-lock" viewBox="0 0 24 24" aria-label="Não incluído"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                  <% end %>
                  <%= label %>
                  <% if key == :soon %><em class="pl-soon">Em breve</em><% end %>
                </li>
              <% end %>
            </ul>
          <% end %>

          <% if cta_kind == :checkout %>
            <%# POST /checkout sem Turbo -> Mercado Pago (CheckoutController) %>
            <%= button_to cta_label, checkout_path(plan_id: plan.id), method: :post,
                          form: { class: "pl-cta-form", data: { turbo: false } },
                          class: "pl-cta pl-cta--buy" %>
          <% else %>
            <span class="pl-cta pl-cta--static"><%= cta_label %></span>
          <% end %>
        </article>
      <% end %>
    </div>

    <p class="pl-footnote">Ao tocar em “Assinar”, você vai para o checkout seguro do Mercado Pago.</p>
  <% end %>
</div>
