<%# Mensagens — layout do mockup (fonte Inter). O título continua o PNG de sempre
    e a barra de navegação de baixo não muda. Estilos em matches.scss; busca, filtro
    "Sua vez" e o arrastar das linhas em chat_list_logic.js. %>
<% content_for :head do %>
  <%# Não lidas mudam a todo momento: voltar do chat (inclusive pelo "voltar" do navegador
      ou o gesto do iPhone) busca a lista de novo em vez de mostrar a cópia guardada %>
  <meta name="turbo-cache-control" content="no-cache">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<% end %>

<% check_icons = {
     "sent"      => '<svg class="conv-check" viewBox="0 0 24 24" aria-label="Enviada"><path d="M5 12.5l4.2 4.2L19 7"/></svg>',
     "delivered" => '<svg class="conv-check" viewBox="0 0 24 24" aria-label="Entregue"><path d="M2 12.5l4.2 4.2L16 7M10.5 16.2l.5.5L21 7"/></svg>',
     "read"      => '<svg class="conv-check is-read" viewBox="0 0 24 24" aria-label="Lida"><path d="M2 12.5l4.2 4.2L16 7M10.5 16.2l.5.5L21 7"/></svg>'
   } %>

<div class="matches-screen-wrapper conversations-page-container">

  <%# --- 1. CABEÇALHO (título PNG de sempre) --- %>
  <div class="matches-header">
    <%= image_tag "texto-mensagen.png", class: "header-title-img", alt: "Mensagens" %>
  </div>

  <%# Busca: filtra as conversas pelo nome %>
  <label class="msg-search">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="search" id="conversations-search-input" placeholder="Buscar conversa" autocomplete="off" aria-label="Buscar conversa">
  </label>

  <%# --- 2. NOVAS CONEXÕES: curtidas + matches que ainda não conversaram --- %>
  <section class="recent-matches-section">
    <h2 class="msg-section-title">Novas conexões</h2>

    <div class="matches-carousel">
      <%= link_to notifications_path, class: "match-item" do %>
        <span class="msg-likes">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          <% unread_likes = current_user.unseen_likes_count %>
          <% if unread_likes > 0 %>
            <span class="msg-likes-count"><%= unread_likes > 99 ? "99+" : unread_likes %></span>
          <% end %>
        </span>
        <span class="match-name">Curtidas</span>
      <% end %>

      <% @matches_uninitiated.each do |match| %>
        <% other = match.other_user(current_user) %>
        <% next if other.nil? %>
        <%# Aro verde = conexão nova (últimas 48 h); bolinha = online %>
        <%= link_to match_path(match), class: "match-item" do %>
          <span class="match-ring <%= 'is-new' if match.created_at > 48.hours.ago %>">
            <%= image_tag other.avatar_url, class: "user-avatar-img", alt: "" %>
            <% if online_now_label(other) %><span class="msg-online" aria-label="Online"></span><% end %>
          </span>
          <span class="match-name"><%= other.display_name.split.first %></span>
        <% end %>
      <% end %>
    </div>
  </section>

  <%# --- 3. CONVERSAS --- %>
  <section class="conversations-section">
    <div class="msg-conv-head">
      <h2 class="msg-section-title">Conversas</h2>
      <% if @matches_initiated.any? %>
        <div class="msg-filter" id="conversations-filter">
          <button type="button" class="msg-filter-btn is-active" data-filter="all" aria-pressed="true">Todas</button>
          <button type="button" class="msg-filter-btn" data-filter="your-turn" aria-pressed="false">
            Sua vez · <span id="conversations-your-turn-count"><%= @your_turn_count %></span>
          </button>
        </div>
      <% end %>
    </div>

    <% if @matches_initiated.any? %>
      <div class="conversations-list" id="conversations-master-list">
        <% @matches_initiated.each do |match| %>
          <% other = match.other_user(current_user) %>
          <% next if other.nil? %>
          <%
            last_msg  = @last_messages[match.id]
            mine      = last_msg && last_msg.sender_id == current_user.id
            unread    = @unread_counts[match.id].to_i
            your_turn = last_msg.present? && !mine
          %>
          <div class="swipe-container" id="match-row-<%= match.id %>"
               data-match-id="<%= match.id %>"
               data-other-user-id="<%= other.id %>"
               data-search-name="<%= other.display_name.to_s.downcase %>"
               data-your-turn="<%= your_turn %>">
            <div class="swipe-actions">
              <button class="swipe-btn swipe-btn-clear" type="button" aria-label="Limpar conversa">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
                </svg>
                <span>Limpar</span>
              </button>
              <button class="swipe-btn swipe-btn-block" type="button" aria-label="Bloquear usuário">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                </svg>
                <span>Bloquear</span>
              </button>
            </div>

            <div class="swipe-content">
              <%= link_to match_path(match), class: "conversation-row #{'is-unread' if unread.positive?}" do %>
                <span class="conv-avatar-container">
                  <%= image_tag other.avatar_url, class: "conv-avatar", alt: "" %>
                  <% if online_now_label(other) %><span class="msg-online" aria-label="Online"></span><% end %>
                </span>

                <span class="conv-details">
                  <span class="conv-name-line">
                    <span class="conv-name"><%= other.display_name %></span>
                    <% if other.verified? %>
                      <svg class="conv-verified" viewBox="0 0 24 24" aria-label="Perfil verificado"><circle cx="12" cy="12" r="11"/><path d="M7 12.5l3.2 3.2L17 9"/></svg>
                    <% end %>
                  </span>
                  <span class="conv-last-message">
                    <% if last_msg %>
                      <% if mine %><%= check_icons.fetch(last_msg.status, check_icons["sent"]).html_safe %>Você: <% end %><%= truncate(last_msg.content, length: 80) %>
                    <% else %>
                      <em class="conv-empty">Sem mensagens</em>
                    <% end %>
                  </span>
                </span>

                <span class="conv-meta">
                  <span class="conv-time"><%= conversation_time_label(last_msg&.created_at || match.created_at) %></span>
                  <% if unread.positive? %>
                    <span class="conv-unread" aria-label="<%= unread %> não lida(s)"><%= unread > 99 ? "99+" : unread %></span>
                  <% end %>
                </span>
              <% end %>
            </div><!-- .swipe-content -->
          </div><!-- .swipe-container -->
        <% end %>
      </div>
      <p class="empty-conversations" id="conversations-search-empty" hidden>Nenhuma conversa encontrada.</p>
    <% else %>
      <div class="empty-conversations">
        <p>Nenhuma conversa ainda.</p>
      </div>
    <% end %>
  </section>

</div>
