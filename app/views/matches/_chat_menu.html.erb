<%# Menu dos três pontinhos da conversa (layout do mockup). Silenciar e Limpar são
    enviados por fetch no chat_logic.js; sem JS, os formulários funcionam sozinhos.
    Desfazer match abre a confirmação matches/_unmatch_confirm. %>
<% first_name = other_user.display_name.split.first %>
<% muted = match.muted_for?(current_user) %>
<div class="gm-chat-menu" data-chat-menu-target="menu" role="menu" hidden>

  <div class="gm-menu-group">
    <%= link_to user_path(other_user), class: "gm-menu-row", role: "menuitem" do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0 1 16 0v1"/></svg>
      Ver perfil
    <% end %>

    <% if Match.chat_controls? %>
      <%= button_to mute_match_path(match), method: :patch, class: "gm-menu-row", id: "mute-chat-btn",
                    form_class: "gm-menu-form", data: { muted: muted } do %>
        <svg class="gm-icon-muted" viewBox="0 0 24 24" aria-hidden="true" <%= "hidden" unless muted %>><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        <svg class="gm-icon-unmuted" viewBox="0 0 24 24" aria-hidden="true" <%= "hidden" if muted %>><path d="M8.7 3A6 6 0 0 1 18 8a21.3 21.3 0 0 0 .6 5M17 17H3s3-2 3-9a4.67 4.67 0 0 1 .3-1.7"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0M2 2l20 20"/></svg>
        <span class="gm-mute-label"><%= muted ? "Ativar notificações" : "Silenciar notificações" %></span>
      <% end %>
    <% end %>
  </div>

  <div class="gm-menu-group">
    <%= button_to clear_conversation_match_path(match), method: :delete, class: "gm-menu-row", id: "clear-chat-btn",
                  form_class: "gm-menu-form" do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      Limpar conversa
    <% end %>

    <%# Abre a confirmação "Desfazer match com …?" (matches/_unmatch_confirm) %>
    <button type="button" class="gm-menu-row" role="menuitem" id="unmatch-chat-btn"
            data-action="chat-menu#openUnmatch">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="m12 13-1-1 2-2-3-3 2-2"/></svg>
      Desfazer match
    </button>

    <%= link_to report_incident_path(user_id: other_user.id), class: "gm-menu-row is-danger", role: "menuitem" do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 22V4a1 1 0 0 1 1-1h11l-2 4.5 2 4.5H5"/></svg>
      Denunciar <%= first_name %>
    <% end %>

    <button type="button" class="gm-menu-row is-danger is-strong" role="menuitem"
            onclick="openBlockConfirm('<%= j other_user.display_name %>', '<%= block_user_path(other_user) %>')">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>
      Bloquear <%= first_name %>
    </button>
  </div>

</div>
