<%# Ajuda e suporte (/suporte) — aberta por "Ajuda e suporte" em Meu Perfil; também é
    pública (link "Central de Suporte" do rodapé). Layout do mockup; estilos .hs-* em
    help_support.scss. O FAQ é um <details> por pergunta (a primeira já aberta) e
    alimenta também o FAQPage do schema.org. %>
<%
  support_email = "suporte@geomatchbr.com"
  faq = [
    [ "Como excluir minha conta?",
      "Vá em <strong>Perfil › Configurações › Encerrar conta</strong>. Se precisar de ajuda, mande um e-mail com o assunto “Excluir conta”." ],
    [ "Como cancelar minha assinatura?",
      "Os planos pagos não renovam sozinhos: valem até a data mostrada em <strong>Planos</strong> e depois voltam para o Free, sem nova cobrança. Para pedir reembolso, mande um e-mail." ],
    [ "Como denunciar alguém?",
      "Abra o perfil da pessoa e toque em <strong>Denunciar</strong>, no fim da página, ou use <strong>Central de Segurança › Denunciar</strong>. Nossa equipe analisa as denúncias em até 24 horas." ],
    [ "Não recebo notificações",
      "Confira se as notificações do GeoMatch estão permitidas nos ajustes do celular (<strong>Ajustes › Notificações › GeoMatch</strong>) ou do navegador, se você usa pelo site. Depois feche e abra o app de novo." ]
  ]
%>

<script type="application/ld+json">
<%= raw({
  "@context": "https://schema.org/",
  "@type": "FAQPage",
  "mainEntity": faq.map { |question, answer|
    { "@type": "Question", "name": question,
      "acceptedAnswer": { "@type": "Answer", "text": strip_tags(answer) } }
  }
}.to_json) %>
</script>

<div class="help-support">

  <%# --- 1. TOPO --- %>
  <div class="hs-header">
    <%= link_to (user_signed_in? ? my_profile_path : root_path), class: "hs-back", aria: { label: "Voltar" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    <% end %>
    <div class="hs-heading">
      <h1 class="hs-title"><span>Ajuda e suporte</span></h1>
      <p class="hs-subtitle">Precisa de ajuda? Estamos aqui para você.</p>
    </div>
  </div>

  <%# --- 2. FALE COM A GENTE --- %>
  <section class="hs-contact">
    <div class="hs-contact-head">
      <span class="hs-contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3.5 7.5l8.5 6 8.5-6"/></svg>
      </span>
      <div>
        <h2 class="hs-contact-title">Fale com a gente</h2>
        <p class="hs-contact-text">Respondemos em até 48 horas úteis</p>
      </div>
    </div>
    <%= mail_to support_email, "Enviar e-mail", subject: "Suporte GeoMatch", class: "hs-contact-btn" %>
    <p class="hs-contact-email"><%= support_email %></p>
  </section>

  <%# --- 3. CENTRAL DE SEGURANÇA (só com login: a página dela pede conta) --- %>
  <% if user_signed_in? %>
    <%= link_to safety_center_path, class: "hs-safety" do %>
      <span class="hs-safety-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4M12 16h.01"/></svg>
      </span>
      <span class="hs-safety-text">
        <strong>Central de Segurança</strong>
        <span>Se for urgente, comece por aqui</span>
      </span>
      <svg class="hs-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>
  <% end %>

  <%# --- 4. PERGUNTAS FREQUENTES --- %>
  <h2 class="hs-section-title">Perguntas frequentes</h2>
  <div class="hs-faq">
    <% faq.each_with_index do |(question, answer), index| %>
      <details class="hs-faq-item" name="faq" <%= "open" if index.zero? %>>
        <summary>
          <span><%= question %></span>
          <svg class="hs-faq-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <p><%= sanitize answer, tags: %w[strong] %></p>
      </details>
    <% end %>
  </div>

  <%# --- 5. DICA --- %>
  <div class="hs-note">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    <p>Para agilizar, conte no e-mail seu nome de usuário e o que aconteceu, com o máximo de detalhes.</p>
  </div>
</div>
