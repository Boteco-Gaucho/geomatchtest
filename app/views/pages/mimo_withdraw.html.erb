<%# Sacar via Pix (/carteira/sacar, "Sacar via Pix" da Carteira). Estilos .wl-* em wallet.scss.
    wallet_controller.js (mode "withdraw"): o valor grande é editável e começa no disponível;
    "Sacar tudo" volta a ele. A chave Pix salva já vem preenchida. "Sacar R$ X" envia
    POST /wallet/withdraw e volta para a Carteira. %>
<% available_cents = @wallet ? @wallet.available_balance_cents : 0 %>
<% minimum_cents   = WithdrawalService::MINIMUM_AMOUNT_CENTS %>
<% key_types = [ [ "cpf", "CPF", "000.000.000-00", "numeric" ], [ "email", "E-mail", "seunome@email.com", "email" ],
                 [ "phone", "Telefone", "(00) 00000-0000", "tel" ], [ "random", "Aleatória", "Cole sua chave aleatória", "text" ] ] %>
<% key_type = key_types.map(&:first).include?(@wallet&.pix_key_type) ? @wallet.pix_key_type : "cpf" %>
<% current  = key_types.find { |k| k.first == key_type } %>
<% money = ->(cents) { number_to_currency(cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") } %>
<div class="wl-page wl-page--form"
     data-controller="wallet"
     data-wallet-mode-value="withdraw"
     data-wallet-verb-value="Sacar"
     data-wallet-available-value="<%= available_cents %>"
     data-wallet-minimum-value="<%= minimum_cents %>"
     data-wallet-key-type-value="<%= key_type %>"
     data-wallet-withdraw-url-value="<%= withdraw_wallet_path %>"
     data-wallet-wallet-page-url-value="<%= mimo_wallet_page_path %>">

  <%= render "pages/wallet_header", back: mimo_wallet_page_path, title: "Sacar via Pix",
             subtitle: "O dinheiro vai direto para a sua conta." %>

  <section class="wl-amount-card wl-amount-card--withdraw">
    <label class="wl-amount-card-label" for="wl-amount">Quanto você quer sacar?</label>
    <div class="wl-amount-edit">
      <span class="wl-amount-edit-currency">R$</span>
      <input id="wl-amount" class="wl-amount-input" type="text" inputmode="numeric" autocomplete="off"
             value="<%= number_with_precision(available_cents / 100.0, precision: 2, delimiter: ".", separator: ",") %>"
             data-wallet-target="amount" data-action="input->wallet#typeAmount focus->wallet#focusAmount">
      <span class="wl-amount-mirror" data-wallet-target="amountMirror" aria-hidden="true"></span>
    </div>
    <p class="wl-available">
      Disponível: <strong><%= money.(available_cents) %></strong>
      <button type="button" class="wl-all" data-action="wallet#withdrawAll">Sacar tudo</button>
    </p>
  </section>

  <h2 class="wl-section-title" id="wl-key-title">Para onde vai o dinheiro?</h2>
  <div class="wl-keys" role="group" aria-labelledby="wl-key-title">
    <% key_types.each do |value, label, placeholder, inputmode| %>
      <button type="button" class="wl-key<%= " is-active" if value == key_type %>" aria-pressed="<%= value == key_type %>"
              data-wallet-target="keyOption" data-key-type="<%= value %>" data-placeholder="<%= placeholder %>"
              data-inputmode="<%= inputmode %>" data-action="wallet#selectKeyType"><%= label %></button>
    <% end %>
  </div>
  <input class="wl-key-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false"
         aria-label="Chave Pix" placeholder="<%= current[2] %>" inputmode="<%= current[3] %>"
         value="<%= @wallet&.pix_key %>" data-wallet-target="keyInput">

  <p class="wl-note">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
    <%# Lê a constante do serviço para o texto nunca divergir da regra aplicada. %>
    <span>Saque mínimo de <strong><%= money.(minimum_cents) %></strong>. O valor cai na sua conta em até 1 dia útil.</span>
  </p>

  <p class="wl-error" role="alert" data-wallet-target="error"></p>

  <div class="wl-footer">
    <button type="button" class="wl-submit" data-wallet-target="submit" data-action="wallet#submit">
      <span data-wallet-target="submitLabel"><%= available_cents.positive? ? "Sacar #{money.(available_cents)}" : "Sacar" %></span>
    </button>
    <p class="wl-footer-note">Confira sua chave Pix antes de confirmar.</p>
  </div>
</div>
